    "/api/CompanyAccount/register-step1-send-otp": {
      "post": {
        "tags": [
          "CompanyAccount"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "CommercialRegisterFile",
                  "CompanyName",
                  "ConfirmPassword",
                  "Email",
                  "Password",
                  "PhoneNumber"
                ],
                "type": "object",
                "properties": {
                  "CompanyName": {
                    "maxLength": 100,
                    "minLength": 3,
                    "type": "string"
                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "PhoneNumber": {
                    "pattern": "^0(10|11|12|15)\\d{8}$",
                    "type": "string"
                  },
                  "CommercialRegisterFile": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Password": {
                    "minLength": 8,
                    "type": "string"
                  },
                  "ConfirmPassword": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "CompanyName": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "PhoneNumber": {
                  "style": "form"
                },
                "CommercialRegisterFile": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "ConfirmPassword": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
